# AVNU paymaster key (https://portal.avnu.fi) — sponsors gas on private swaps.
#
# LOCAL DEVELOPMENT ONLY. `vite dev` serves no serverless functions, so the SDK
# talks to AVNU directly and needs the key in the browser. Copy this file to
# .env.local and fill it in — .env.local is gitignored; NEVER commit it.
VITE_AVNU_PAYMASTER_API_KEY=

# PRODUCTION: do NOT use the VITE_ prefix — that is what inlines a value into
# the publicly-readable browser bundle. Instead set an unprefixed
#
#   AVNU_PAYMASTER_API_KEY=...
#
# in your host's environment (e.g. `vercel env add AVNU_PAYMASTER_API_KEY`).
# The proxy in app/api/paymaster.ts reads it server-side and attaches it to each
# request, so the key never reaches the browser. See app/src/config.ts.

# --- Optional: point the app at your own jar / a different network ---
# Defaults are the live mainnet demo. See docs/DEPLOYMENT.md.
# VITE_TIPJAR_ADDRESS=0x...
# VITE_OWNER_ADDRESS=0x...     # where tips land — CHANGE THIS or you tip the demo creator
# VITE_DEPLOY_BLOCK=123456
# VITE_RPC_URL=https://...
